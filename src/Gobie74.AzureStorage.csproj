<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Build">
    <RootNamespace>Gobie74.AzureStorage</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>Azure Table Storage helper library</Description>
    <PackageProjectUrl>https://github.com/dmelinosky/AzureStorage</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dmelinosky/AzureStorage</RepositoryUrl>
    <Version>2.0.0</Version>
    <Authors>Gobie74</Authors>
    <PackageReleaseNotes>Breaking: target net10.0 and migrate from the deprecated Microsoft.Azure.Cosmos.Table to Azure.Data.Tables. Entities now implement Azure.Data.Tables.ITableEntity and TableAccess wraps a TableClient.</PackageReleaseNotes>
    <PackageDescription>Azure Table Storage helper library</PackageDescription>
    <PackageTags>Azure;Storage;Table;Gobie74</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
